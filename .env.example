# ==============================================================================
# Django core
# ==============================================================================
# config.settings.development locally, config.settings.production on a real host.
DJANGO_SETTINGS_MODULE=config.settings.development

# In production this MUST be at least 50 characters and NOT start with "django-insecure-".
SECRET_KEY=django-insecure-local-development-key-12345678901234567890

# Comma-separated hostnames this site answers on.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated CSRF-trusted origins (with scheme). Required in production for the
# lead form's POST to pass Django's CSRF check.
CSRF_TRUSTED_ORIGINS=https://example.com

# Enforce HTTPS security headers and Secure cookie flags. Only read by
# config.settings.production — leave True unless you have a specific reason not to.
USE_HTTPS=True

# ==============================================================================
# CRM integration — this site is a thin renderer, not a source of truth
# ==============================================================================
# Base URL of the CRM (automobili-zaluppini). All content (branding, calculator,
# SEO, FAQ, car catalogue) is fetched from its public read API at request time;
# leads are forwarded to its POST /api/v1/leads/create/. Nothing is stored locally —
# this site has no database.
CRM_API_BASE_URL=http://127.0.0.1:8000

# slug of the SourceSite row (CRM admin → "Сайты-источники") this deployment renders.
# One codebase, one slug per deployment — a second storefront is a second deployment
# with a different SITE_SLUG, not a code change.
SITE_SLUG=autocredit

# Timeout (seconds) for every call to the CRM API (config, cars, lead submit).
CRM_API_TIMEOUT_SECONDS=5

# How long (seconds) a fetched site config / car list is kept in this site's own
# cache before re-fetching from the CRM. Short on purpose: the CRM is the source of
# truth and already caches by version, this only shields it from a request-per-visit
# load. Per-process (LocMemCache) — fine for a single instance; a multi-worker
# deployment simply re-fetches slightly more often, never serves stale-forever data.
SITE_CONFIG_CACHE_TTL_SECONDS=60

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=INFO
# console (human-readable, dev) or json (structured, for log aggregators in prod).
LOG_FORMAT=console
